# GlassCart Environment Configuration

# Environment mode: 'local' (verbose errors) or 'production' (secure errors)
APP_ENV=local

# Application Base URL (no trailing slash). If https, secure cookie flags are enforced.
APP_URL=http://localhost:8080

# 64-character hexadecimal secret key used for session encryption with libsodium.
# Generate one using: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=c58c0c1693dfb3a985a6760b299e9dcbfd731ff7382283a2169ce3e30fef6a59

# Supabase Project Base URL
SUPABASE_URL=https://zrqipemjxkqovipdferp.supabase.co

# Supabase Publishable / Anon Key (used only for password login token grants)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_token_change_me

# Supabase Secret / Service Role Key (server-side only, NEVER expose to client)
SUPABASE_SECRET_KEY=sb_secret_placeholder_token_change_me

# Supabase Storage bucket for product image uploads
SUPABASE_STORAGE_BUCKET=product-images
